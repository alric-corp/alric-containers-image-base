{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCrossAccountPull",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": [
            "o-5gqr9v3h2q"
          ]
        }
      }
    },
    {
      "Sid": "FactoryHomReadExactSource",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::248908662184:role/alric-image-base-factory-hom"
      },
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:DescribeRepositories",
        "ecr:ListImageReferrers"
      ]
    }
  ]
}
