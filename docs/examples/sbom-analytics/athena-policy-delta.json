{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SbomAnalyticsAthenaWorkgroup",
      "Effect": "Allow",
      "Action": [
        "athena:GetWorkGroup",
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution"
      ],
      "Resource": [
        "arn:aws:athena:us-east-1:712107929769:workgroup/sbom_analytics"
      ]
    },
    {
      "Sid": "SbomAnalyticsGlueReadAndNewTables",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetPartitions",
        "glue:CreateTable"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:712107929769:catalog",
        "arn:aws:glue:us-east-1:712107929769:database/sbom_analytics",
        "arn:aws:glue:us-east-1:712107929769:table/sbom_analytics/sbom_snapshot_0b0c4ed7014746c8facdd779debd435e6a3fb160c5619f7d60751dabf5e4ec0b_sbom_observation_rows_v1",
        "arn:aws:glue:us-east-1:712107929769:table/sbom_analytics/sbom_snapshot_0b0c4ed7014746c8facdd779debd435e6a3fb160c5619f7d60751dabf5e4ec0b_sbom_package_rows_v1",
        "arn:aws:glue:us-east-1:712107929769:table/sbom_analytics/sbom_snapshot_0b0c4ed7014746c8facdd779debd435e6a3fb160c5619f7d60751dabf5e4ec0b_sbom_observations_v1",
        "arn:aws:glue:us-east-1:712107929769:table/sbom_analytics/sbom_snapshot_0b0c4ed7014746c8facdd779debd435e6a3fb160c5619f7d60751dabf5e4ec0b_sbom_packages_v1",
        "arn:aws:glue:us-east-1:712107929769:table/sbom_analytics/sbom_snapshot_0b0c4ed7014746c8facdd779debd435e6a3fb160c5619f7d60751dabf5e4ec0b_sbom_inventory_v1"
      ]
    },
    {
      "Sid": "SbomAnalyticsQueryResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::alric-distroless-sbom-analytics-712107929769-us-east-1/query-results/sbom-analytics-v1/*"
      ]
    }
  ]
}
