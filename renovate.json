{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "automerge": false,
  "prConcurrentLimit": 4,
  "timezone": "America/Sao_Paulo",
  "schedule": [
    "before 6am on monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/(?:build-base-images|ci|image-trust)\\.yml$/",
        "/^scripts/pipeline/runtime/runtime_images\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>cgr\\.dev/chainguard/(?:apko|melange)|rhysd/actionlint)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-base-images\\.yml$/",
        "/^scripts/pipeline/runtime/runtime_images\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>quay\\.io/skopeo/stable):(?<currentValue>v\\d+\\.\\d+\\.\\d+-immutable)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-immutable$"
    }
  ]
}
