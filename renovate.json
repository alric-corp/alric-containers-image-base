{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "automerge": false,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "dependencyDashboard": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "timezone": "America/Sao_Paulo",
  "packageRules": [
    {
      "description": "Renovate Skopeo POC (TODO/RENOVATE-SKOPEO-POC.md): nenhuma dependência abre branch/PR por padrão. Os customManagers continuam extraindo e o pin_inventory continua exigindo cobertura.",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "description": "Renovate Skopeo POC: única dependência habilitada. Tag -immutable + digest, sem automerge.",
      "matchPackageNames": [
        "quay.io/skopeo/stable"
      ],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/(?:build-base-images|ci|image-trust)\\.yml$/",
        "/^scripts/pipeline/runtime/runtime_images\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>cgr\\.dev/chainguard/(?:apko|melange)|rhysd/actionlint)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-base-images\\.yml$/",
        "/^scripts/pipeline/runtime/runtime_images\\.py$/"
      ],
      "matchStrings": [
        "(?<depName>quay\\.io/skopeo/stable):(?<currentValue>v\\d+\\.\\d+\\.\\d+-immutable)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-immutable$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/infra-(?:pr|apply)\\.yml$/"
      ],
      "matchStrings": [
        "TF_VERSION:\\s*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)"
      ],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "hashicorp",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:app-certification|dev-stable)\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>docker\\.io/tonistiigi/binfmt):(?<currentValue>qemu-v\\d+\\.\\d+\\.\\d+-\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
