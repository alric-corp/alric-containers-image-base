.DS_Store

# Preferências pessoais de ferramentas de IA.
CLAUDE.local.md
.claude/settings.local.json

# Local Python environments and interpreter output.
.venv/
__pycache__/
*.py[cod]

# Pipeline outputs; reviewed evidence belongs in docs/evidence or tests/runtime.
/reports/
/*.oci/
/melange-repo/
/apko

# melange local signing key + build output (regenerated on every build)
melange/.local-keys/
melange/packages/
melange/melange-cache/
*.rsa
*.rsa.pub
!melange/keys/wolfi-signing.rsa.pub
# Ancoras de confianca pinadas da fonte de excecao Alpine v3.24: precisam ser
# versionadas, senao o contrato de keyring nao tem contra o que comparar.
!melange/keys/alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub
!melange/keys/alpine-devel@lists.alpinelinux.org-616ae350.rsa.pub

# apko/docker build artifacts
*.tar
sbom-*.json
*.spdx.json

# Reviewed reusable workflows checked out for offline CI contract checks.
.reusable-workflows/

# Isolated CA integration builds (including ephemeral test keys).
.composition-fixture-*/
