<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- RuntimeMajor vem do catalogo (dotnet10 -> 10, dotnet8 -> 8): o mesmo
         projeto compila no SDK que acompanha a imagem candidata. Sem a
         propriedade, o alvo continua sendo net10.0, como antes. -->
    <RuntimeMajor Condition="'$(RuntimeMajor)' == ''">10</RuntimeMajor>
    <TargetFramework>net$(RuntimeMajor).0</TargetFramework>
    <AssemblyName>runtime-contract</AssemblyName>
    <RootNamespace>RuntimeContract</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Sem ICU: a imagem de runtime é distroless e não garante os dados de
         globalização; sem isso o processo falharia na inicialização. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Restore offline: o projeto só referencia o framework compartilhado,
         que já vem no SDK. Nenhuma fonte NuGet é consultada (ver NuGet.config)
         e o build roda sem rede nenhuma. -->
    <RestorePackages>false</RestorePackages>
  </PropertyGroup>
</Project>
